<Window x:Class="TidyFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyFlow.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="TidyFlow"
        Width="1000" Height="760"
        MinWidth="820" MinHeight="600"
        Icon="/Assets/icon.ico"
        AutomationProperties.Name="TidyFlow">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F5" Command="{Binding OrganizeNowCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="IconButtonText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        </Style>

        <Style TargetType="ScrollViewer" x:Key="Page">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="24,16,24,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,16,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/icon.ico" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="TidyFlow" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="Sorting your files, to clean up your mess." Style="{StaticResource HelpText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border CornerRadius="12" Padding="10,4"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        Visibility="{Binding IsWatching, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="New files in your source folder are organized automatically">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Watching for new files" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Status banner -->
        <Border Grid.Row="1" Margin="24,8,24,0" CornerRadius="6" Padding="14,10" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="1" Command="{Binding DismissStatusCommand}" Margin="12,0,0,0" Padding="8,4"
                        ToolTip="Dismiss" AutomationProperties.Name="Dismiss message">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"/>
                </Button>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="12,8,12,0">

            <!-- Dashboard -->
            <TabItem Header="Dashboard">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <UniformGrid Columns="4" Margin="-8,0,-8,8">
                            <Border Style="{StaticResource Card}" Margin="8,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalFiles}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="Files organized" Style="{StaticResource HelpText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalSize}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="Space tidied" Style="{StaticResource HelpText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding TodayFiles}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="Files today" Style="{StaticResource HelpText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding DaysActive}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="Days active" Style="{StaticResource HelpText}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding OrganizeNowCommand}"
                                            AutomationProperties.Name="Organize now"
                                            Margin="0,0,8,8" ToolTip="Organize your source folder now (F5)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource IconButtonText}"/>
                                            <TextBlock Text="Organize now"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding PreviewCommand}" Margin="0,0,8,8" AutomationProperties.Name="Preview changes"
                                            ToolTip="See what would be moved before anything happens">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE890;" Style="{StaticResource IconButtonText}"/>
                                            <TextBlock Text="Preview changes"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding UndoLastCommand}" Margin="0,0,8,8" AutomationProperties.Name="Undo last run"
                                            ToolTip="Move the files from the most recent run back">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A7;" Style="{StaticResource IconButtonText}"/>
                                            <TextBlock Text="Undo last run"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenSourceFolderCommand}" Margin="0,0,8,8" AutomationProperties.Name="Open source folder">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource IconButtonText}"/>
                                            <TextBlock Text="Open source folder"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding LastRunText}" Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding ScheduleStatusText}" Style="{StaticResource HelpText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Recently organized" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Nothing yet. Select Organize now, or Preview changes to see what TidyFlow would do.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActivity}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding RecentActivity}"
                                              Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ActivityItemViewModel}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding WhenText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Rules -->
            <TabItem Header="Rules">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Folder to organize" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Folder to organize"/>
                                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,8,0,0"
                                           Text="Only files directly in this folder are organized. Subfolders are never touched. You can use variables such as %USERPROFILE%."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Categories" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,12"
                                           Text="Files are matched by extension. If two categories list the same extension, the one higher in the list wins."/>
                                <DataGrid ItemsSource="{Binding Categories}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          MaxHeight="340"
                                          AutomationProperties.Name="Categories">
                                    <DataGrid.Columns>
                                        <!-- A template column so one click toggles it (DataGridCheckBoxColumn needs two). -->
                                        <DataGridTemplateColumn Header="On" Width="56">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding Name, StringFormat=Enable {0}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Name" Width="130"
                                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Extensions" Width="*"
                                                            Binding="{Binding ExtensionsText, UpdateSourceTrigger=LostFocus}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding ExtensionsText}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Moves to" Width="*"
                                                            Binding="{Binding Destination, UpdateSourceTrigger=LostFocus}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding Destination}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Padding="8,4" Margin="0,0,4,0" ToolTip="Choose destination folder"
                                                                AutomationProperties.Name="Choose destination folder"
                                                                Command="{Binding DataContext.BrowseDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"/>
                                                        </Button>
                                                        <Button Padding="8,4" ToolTip="Remove category"
                                                                AutomationProperties.Name="Remove category"
                                                                Command="{Binding DataContext.RemoveCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Command="{Binding AddCategoryCommand}" Margin="0,0,8,0" AutomationProperties.Name="Add category">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource IconButtonText}"/>
                                            <TextBlock Text="Add category"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Restore defaults" Command="{Binding RestoreDefaultCategoriesCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="What to leave alone" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Files changed in the last (hours)" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBox Text="{Binding FileAgeThresholdHours, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                 AutomationProperties.Name="Skip files changed in the last hours"/>
                                        <TextBlock Text="0 = no limit. Doesn't apply to watched-folder moves." Style="{StaticResource HelpText}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="Files smaller than (KB)" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBox Text="{Binding MinFileSizeKB, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                 AutomationProperties.Name="Skip files smaller than kilobytes"/>
                                        <TextBlock Text="0 = no limit." Style="{StaticResource HelpText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="If the name is already taken" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" MinWidth="320" HorizontalAlignment="Left"
                                              ItemsSource="{x:Static vm:Choices.DuplicateStrategies}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding DuplicateHandling}"
                                              AutomationProperties.Name="If the name is already taken"/>

                                    <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12"
                                              Content="Leave hidden and system files alone (desktop.ini, thumbs.db)"
                                              IsChecked="{Binding SkipHiddenFiles}"/>

                                    <StackPanel Grid.Row="4">
                                        <TextBlock Text="Files matching these patterns" Margin="0,6,16,0"/>
                                        <TextBlock Text="One per line. * matches anything, ? one character."
                                                   Style="{StaticResource HelpText}" Margin="0,4,16,0"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="4" Grid.Column="1" Height="110" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding ExcludePatternsText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Exclude patterns"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Schedule -->
            <TabItem Header="Schedule">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Organize automatically" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="On a schedule" IsChecked="{Binding ScheduleEnabled}" Margin="0,0,0,12"/>
                                <Grid Margin="28,0,0,12" IsEnabled="{Binding ScheduleEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Width="150" Margin="0,0,8,0"
                                              ItemsSource="{x:Static vm:Choices.Frequencies}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Frequency}"
                                              AutomationProperties.Name="How often"/>
                                    <ComboBox Grid.Column="1" Width="150" Margin="0,0,8,0"
                                              ItemsSource="{x:Static vm:Choices.DaysOfWeek}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding DayOfWeek}"
                                              Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Day of the week"/>
                                    <ComboBox Grid.Column="1" Width="150" Margin="0,0,8,0"
                                              ItemsSource="{x:Static vm:Choices.DaysOfMonth}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding DayOfMonth}"
                                              Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Day of the month"/>
                                    <TextBlock Grid.Column="2" Text="at" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                    <TextBox Grid.Column="3" Width="90" Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="24-hour time, for example 02:00 or 18:30"
                                             AutomationProperties.Name="Time of day"/>
                                </Grid>
                                <CheckBox Content="A minute after I sign in to Windows" IsChecked="{Binding RunAtSignIn}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding ScheduleStatusText}" Style="{StaticResource HelpText}"/>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0"
                                           Text="Scheduled runs happen in the background. If your PC is off or asleep at the scheduled time, TidyFlow runs as soon as it can."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Watch for new files" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Organize new files as soon as they arrive" IsChecked="{Binding WatcherEnabled}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="New files are moved about 15 seconds after they finish downloading, ignoring the 'changed in the last hours' rule. This works while TidyFlow is running; turn on 'Start TidyFlow when I sign in' under Settings to keep it running in the notification area. Takes effect immediately."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- History -->
            <TabItem Header="History">
                <ScrollViewer Style="{StaticResource Page}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Past runs" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,12"
                                       Text="Every run, scheduled or manual, is kept here so you can put files back. Hover over a run to see what moved."/>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8"
                                                Background="Transparent" ToolTip="{Binding Details}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding WhenText}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TriggerText}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="3">
                                                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Button Content="Undo" Padding="12,4"
                                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.UndoBatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="These settings take effect immediately." Style="{StaticResource HelpText}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                                <ComboBox Width="260" HorizontalAlignment="Left"
                                          ItemsSource="{x:Static vm:Choices.Themes}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Theme}"
                                          AutomationProperties.Name="Theme"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Startup and notification area" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Start TidyFlow when I sign in to Windows (in the notification area)" IsChecked="{Binding LaunchAtSignIn}" Margin="0,0,0,8"/>
                                <CheckBox Content="Keep running in the notification area when I close the window" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,8"/>
                                <CheckBox Content="Start minimized to the notification area" IsChecked="{Binding StartMinimized}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Notify me when files are organized in the background" IsChecked="{Binding ShowNotifications}" Margin="0,0,0,8"/>
                                <CheckBox Content="Play a sound" IsChecked="{Binding PlaySounds}" IsEnabled="{Binding ShowNotifications}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Your data" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel>
                                    <Button Content="Export settings…" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,8"/>
                                    <Button Content="Import settings…" Command="{Binding ImportSettingsCommand}" Margin="0,0,8,8"/>
                                    <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,8"/>
                                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8"/>
                                    <Button Content="Reset statistics…" Command="{Binding ResetStatisticsCommand}" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="TidyFlow keeps everything on this PC. It never uploads your files or settings."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding VersionText}"/>
                                <TextBlock Text="{Binding DistributionText}" Style="{StaticResource HelpText}" Margin="0,2,0,8"/>
                                <TextBlock>
                                    <Hyperlink Command="{Binding OpenProjectPageCommand}">Source code and issue tracker</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Unsaved changes bar -->
        <Border Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="You have unsaved changes to your rules or schedule." VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Discard" Command="{Binding DiscardChangesCommand}" Margin="0,0,8,0"/>
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}"
                            ToolTip="Save (Ctrl+S)" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
